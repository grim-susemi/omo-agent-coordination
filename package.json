{
  "name": "piomo-agent-coordination-mod",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": ["./dist/extension.js"]
  },
  "peerDependencies": {
    "@code-yeongyu/senpi": "*"
  },
  "exports": {
    "./api": {
      "types": "./src/public-api.ts",
      "import": "./dist/public-api.js"
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts src/public-api.ts --outdir dist --target node --format esm --external @code-yeongyu/senpi",
    "check": "tsc --noEmit && bun test && bun run qa:isolated",
    "qa:isolated": "bun run qa/harness.ts",
    "qa:owned": "bun run qa/owned.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  }
}
